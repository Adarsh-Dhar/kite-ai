# ============================================================
# Market Architect Agent — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.
# ============================================================

# --- GitHub ---
# Personal Access Token with repo:read and read:discussion scopes.
# Fine-grained PATs are preferred over classic tokens.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GraphQL endpoint (default: GitHub public API)
GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# Repository to scout (owner/repo format)
SCOUT_REPO_OWNER=anza-xyz
SCOUT_REPO_NAME=agave

# How many PRs to fetch per poll cycle
SCOUT_PR_FETCH_LIMIT=20

# Minimum Technical Significance Score to pass the "No-Slop" filter
TSS_THRESHOLD=60


# --- LLM Integration ---
# Groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Kite AI Blockchain ---
# Your agent's wallet private key (base58 encoded).
KITE_AGENT_PRIVATE_KEY=your_base58_private_key_here

# Kite AI RPC endpoint
KITE_RPC_URL=https://rpc.testnet.kiteai.io

# Kite AI REST API key (for off-chain agent registry)
KITE_API_KEY=kite_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Smart Contract Factory address on Kite AI
KITE_MARKET_FACTORY_ADDRESS=0xYourMarketFactoryAddressHere

# USDC token contract address on Kite AI
KITE_USDC_ADDRESS=0xYourUSDCAddressHere

# Default market funding amount in USDC (6 decimal places = 100 USDC)
MARKET_INITIAL_FUNDING_USDC=100000000

# Session key TTL in seconds (default: 24 hours)
SESSION_KEY_TTL=86400

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# How often the scout polling loop runs (seconds)
POLL_INTERVAL_SECONDS=300

HOST=0.0.0.0
PORT=8000
