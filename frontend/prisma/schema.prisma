generator py {
  provider                    = "prisma-client-py"
  interface                   = "asyncio"
  enable_experimental_decimal = true
  output                      = "../server/lib/generated/client"
  recursive_type_depth        = 5
  engineType                  = "binary"
}

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/client"
}


datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
//  Enums
// ─────────────────────────────────────────────────────────────────────────────

enum MarketStatus {
  OPEN
  PENDING_RESOLUTION
  RESOLVED
  INVALID
  PAUSED
}

enum Outcome {
  UNRESOLVED
  YES
  NO
  INVALID
}

enum ResolutionType {
  GITHUB_PR          // Resolved by checking PR merged state via GitHub API
  GITHUB_RELEASE     // Resolved by checking for a release tag
  GITHUB_ISSUE       // Resolved by checking issue state
  CI_METRIC          // Resolved by parsing CI/CD check run artifacts
  CVE_SECURITY       // Resolved by monitoring GitHub Security Advisories / NVD
  WEB3_RPC           // Resolved by querying on-chain data via RPC
  DAO_GOVERNANCE     // Resolved by querying Snapshot or on-chain vote counts
  LLM_JUDGE          // Fallback: resolved by an LLM evaluating fetched text
}

// ─────────────────────────────────────────────────────────────────────────────
//  Core Tables
// ─────────────────────────────────────────────────────────────────────────────

model Market {
  id                String         @id @default(cuid())

  // On-chain identifiers
  onchainMarketId   Int?           @unique @map("onchain_market_id")
  transactionHash   String?        @unique @map("transaction_hash")
  blockNumber       Int?           @map("block_number")
  contractAddress   String?        @map("contract_address")

  // Market content
  title             String
  question          String         @db.Text
  category          String
  options           String[]       @default(["Yes", "No"])
  agentReason       String         @db.Text @map("agent_reason")

  // Resolution strategy (the "Golden Rule" — deterministic and machine-readable)
  resolutionType    ResolutionType @map("resolution_type")
  dataSourceUrl     String         @map("data_source_url") @db.Text
  evaluationLogic   Json           @map("evaluation_logic")
  // evaluationLogic shape varies by ResolutionType:
  //   GITHUB_PR:      { "check": "merged", "field": "mergedAt", "deadline": ISO8601 }
  //   GITHUB_RELEASE: { "tag_pattern": "v2.1.*", "deadline": ISO8601 }
  //   CI_METRIC:      { "metric": "coverage_delta", "operator": ">=", "threshold": 2.0, "artifact_name": "coverage-report.json" }
  //   CVE_SECURITY:   { "severity": "CRITICAL", "package": "agave-consensus", "deadline": ISO8601 }
  //   WEB3_RPC:       { "method": "eth_getLogs", "address": "0x...", "event_sig": "0x...", "threshold": 10000 }
  //   DAO_GOVERNANCE: { "proposal_id": "0x...", "endpoint": "https://hub.snapshot.org/graphql", "quorum": 0.66 }
  //   LLM_JUDGE:      { "fetch_urls": ["..."], "question": "Did X happen?", "uncertainty_action": "INVALID" }

  // Source PR metadata
  sourcePrNumber    Int?           @map("source_pr_number")
  sourcePrUrl       String?        @map("source_pr_url")
  tssScore          Float?         @map("tss_score")

  // Market status
  status            MarketStatus   @default(OPEN)
  outcome           Outcome        @default(UNRESOLVED)
  resolvedAt        DateTime?      @map("resolved_at")
  resolutionTxHash  String?        @map("resolution_tx_hash")
  resolutionNote    String?        @db.Text @map("resolution_note")

  // Financials (mirrors on-chain state, cached for analytics)
  initialLiquidityEth Float?       @map("initial_liquidity_eth")
  resolutionDeadline  DateTime?    @map("resolution_deadline")

  // Resolver retry tracking
  resolveAttempts   Int            @default(0) @map("resolve_attempts")
  lastAttemptAt     DateTime?      @map("last_attempt_at")
  nextRetryAt       DateTime?      @map("next_retry_at")
  lastError         String?        @db.Text @map("last_error")

  // Timestamps
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  resolutionLogs    ResolutionLog[]
  prRecord          DeployedPR?

  @@index([status])
  @@index([resolutionType])
  @@index([sourcePrNumber])
  @@index([nextRetryAt])
  @@map("markets")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Deployed PRs (replaces .deployed_prs.json)
// ─────────────────────────────────────────────────────────────────────────────

model DeployedPR {
  id          String    @id @default(cuid())
  prNumber    Int       @unique @map("pr_number")
  prTitle     String    @map("pr_title")
  prUrl       String?   @map("pr_url")
  mergedAt    DateTime? @map("merged_at")
  tssScore    Float?    @map("tss_score")
  deployedAt  DateTime  @default(now()) @map("deployed_at")

  // Link to the market created for this PR
  marketId    String?   @unique @map("market_id")
  market      Market?   @relation(fields: [marketId], references: [id])

  @@index([prNumber])
  @@map("deployed_prs")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Resolution Audit Log
// ─────────────────────────────────────────────────────────────────────────────

model ResolutionLog {
  id            String    @id @default(cuid())
  marketId      String    @map("market_id")
  market        Market    @relation(fields: [marketId], references: [id])

  attemptNumber Int       @map("attempt_number")
  resolverType  String    @map("resolver_type")  // e.g. "GITHUB_PR", "LLM_JUDGE"

  // What the resolver fetched
  rawResponse   Json?     @map("raw_response")

  // Decision
  decision      String    // "YES", "NO", "INVALID", "PENDING", "ERROR"
  reasoning     String?   @db.Text

  // On-chain outcome (if pushed)
  txHash        String?   @map("tx_hash")
  blockNumber   Int?      @map("block_number")

  error         String?   @db.Text
  attemptedAt   DateTime  @default(now()) @map("attempted_at")

  @@index([marketId])
  @@index([attemptedAt])
  @@map("resolution_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Agent Cycles (observability)
// ─────────────────────────────────────────────────────────────────────────────

model AgentCycle {
  id                  String    @id @default(cuid())
  cycleType           String    @map("cycle_type")  // "SCOUT" | "RESOLVER"
  startedAt           DateTime  @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")
  durationMs          Int?      @map("duration_ms")

  prsAnalysed         Int?      @default(0) @map("prs_analysed")
  marketsProposed     Int?      @default(0) @map("markets_proposed")
  marketsDeployed     Int?      @default(0) @map("markets_deployed")
  marketsResolved     Int?      @default(0) @map("markets_resolved")

  errors              String[]  @default([])
  metadata            Json?

  @@index([cycleType])
  @@index([startedAt])
  @@map("agent_cycles")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Security Advisories Cache (for CVE_SECURITY markets)
// ─────────────────────────────────────────────────────────────────────────────

model SecurityAdvisory {
  id            String    @id @default(cuid())
  cveId         String?   @unique @map("cve_id")
  ghsaId        String?   @unique @map("ghsa_id")
  severity      String    // CRITICAL, HIGH, MEDIUM, LOW
  packageName   String?   @map("package_name")
  summary       String?   @db.Text
  publishedAt   DateTime? @map("published_at")
  rawPayload    Json?     @map("raw_payload")
  fetchedAt     DateTime  @default(now()) @map("fetched_at")

  @@index([severity])
  @@index([publishedAt])
  @@map("security_advisories")
}
